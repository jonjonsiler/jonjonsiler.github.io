---
import GenericPageLayout from '@layouts/generic.astro';
---
<GenericPageLayout title="Generic content">
  <div class="section-shell space-y-12">
    <header class="space-y-4 text-center md:text-left">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-sky-300">
        Narrative
      </p>
      <h1 class="text-4xl font-semibold tracking-tight text-white md:text-5xl">
        Generic
      </h1>
      <p class="max-w-3xl text-sm text-slate-300 md:text-base">
        A long-form canvas for sharing deeper context, anchored in a focused visual story.
      </p>
    </header>
    <article class="surface-card overflow-hidden">
      <img
        src="/images/pic11.jpg"
        alt="Sunset over a mountain range"
