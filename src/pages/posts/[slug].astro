---
import GenericPageLayout from "@layouts/generic.astro";
import type { PostItem } from "@/models";

const apiBaseUrl = import.meta.env.API_BASE_URL ?? "";
const apiKey = import.meta.env.API_KEY;
const headers: Record<string, string> = { Accept: "application/json" };

export async function getStaticPaths() {
  const site = import.meta.env.SITE ?? "http://localhost:4321";
  const response = await fetch(new URL("/api/posts.json", site));
  if (!response.ok) {
    throw new Error(`Failed to load posts index: ${response.status}`);
  }
  const posts = (await response.json()) as { slug: string }[];
  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
if (apiKey) headers.Authorization = `Bearer ${apiKey}`;
if (!apiBaseUrl) {
  throw new Response("Post not found", { status: 404 });
}

const response = await fetch(`${apiBaseUrl}/api/posts/${slug}.json`, {
  headers,
});
if (!response.ok) {
  throw new Response("Post not found", { status: response.status });
}
const post = (await response.json()) as PostItem;

const dateOptions: Intl.DateTimeFormatOptions = {
  year: "numeric",
  month: "long",
  day: "numeric",
};
const formattedDate = new Date(post.publishedAt).toLocaleDateString(undefined, dateOptions);
---

<GenericPageLayout title={post.title}>
  <article class="section-shell space-y-8 py-10">
    <header class="space-y-4">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-sky-300">
        Microjournal
      </p>
      <h1 class="text-4xl font-semibold tracking-tight text-white md:text-5xl">{post.title}</h1>
      <p class="text-sm uppercase tracking-[0.35em] text-slate-400">{formattedDate}</p>
      <p class="max-w-3xl text-base text-slate-300 md:text-lg">{post.summary}</p>
    </header>
    <div class="prose prose-invert max-w-none text-slate-200 prose-a:text-sky-300 prose-pre:bg-slate-900/60 prose-pre:text-slate-100 prose-code:text-sky-200" set:html={post.contentHtml} />
  </article>
</GenericPageLayout>
