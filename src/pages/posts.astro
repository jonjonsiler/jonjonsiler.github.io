---
import GenericPageLayout from '@layouts/generic.astro';
import { Posts as BlogPosts } from '@components/posts';

const apiBaseUrl = import.meta.env.API_BASE_URL ?? '';
---
<GenericPageLayout title="Blog Posts">
  <div class="section-shell space-y-10">
    <header class="space-y-3 text-center md:text-left">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-sky-300">
        Microjournal
      </p>
      <h1 class="text-4xl font-semibold tracking-tight text-white md:text-5xl">
        Notes from the trenches
      </h1>
      <p class="mx-auto max-w-3xl text-sm text-slate-300 md:mx-0 md:text-base">
        Occasional snapshots of the work, technology, and teams that keep me tinkering.
      </p>
    </header>
    <BlogPosts apiBaseUrl={apiBaseUrl} client:load />
  </div>
</GenericPageLayout>
