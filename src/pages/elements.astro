---
import GenericPageLayout from '@layouts/generic.astro';

const checklist = [
  'Dolor etiam magna etiam. Volutpat posuere ornare.',
  'Sagittis lorem eleifend amet fermentum.',
  'Felis dolore viverra feugiat suscipit.',
];

const ordered = [
  'Dolor etiam magna etiam.',
  'Etiam vel lorem sed viverra.',
  'Felis dolore viverra.',
  'Gravida eget quam sapien.',
];

const tableRows = [
  { name: 'Item1', description: 'Ante turpis integer aliquet porttitor.', price: '$29.99' },
  { name: 'Item2', description: 'Vis ac commodo adipiscing arcu aliquet.', price: '$19.99' },
  { name: 'Item3', description: 'Morbi faucibus arcu accumsan lorem.', price: '$24.99' },
];
---
<GenericPageLayout title="Elements">
  <main class="space-y-24 pb-24">
    <section class="section-shell space-y-10">
      <header class="space-y-3 text-center md:text-left">
        <p class="text-xs font-semibold uppercase tracking-[0.35em] text-sky-300">
          Elements
        </p>
        <h1 class="text-4xl font-semibold tracking-tight text-white md:text-5xl">
          A small pattern library
        </h1>
        <p class="max-w-3xl text-sm text-slate-300 md:text-base">
          Quick previews of typography, components, and interactive states now powered by Tailwind. Use these building blocks as a starting point for new sections and templates.
        </p>
      </header>
      <article class="surface-card space-y-6 p-8 md:p-12">
        <h2 class="text-3xl font-semibold tracking-tight text-white md:text-4xl">Typography</h2>
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis dapibus rutrum facilisis. Class aptent taciti sociosqu ad litora torquent per conubia nostra, per inceptos himenaeos. Etiam tristique libero eu nibh porttitor fermentum. Nullam venenatis erat id vehicula viverra.</p>
        <div class="grid gap-6 md:grid-cols-2">
          <div class="space-y-3">
            <h3 class="text-2xl font-semibold text-white">Heading level 3</h3>
            <p>Aliquam ac ante interdum, feugiat lectus sed, gravida felis. Pellentesque molestie, ipsum vel maximus pulvinar, sapien purus lobortis lorem, sed mattis ex nisl vitae ipsum.</p>
          </div>
          <blockquote class="rounded-2xl border border-slate-800/70 bg-slate-900/70 p-6 text-sm text-slate-300">
            “Fringilla nisl. Donec accumsan interdum nisi, quis tincidunt felis sagittis eget tempus euismod vestibulum.”
          </blockquote>
        </div>
        <pre class="overflow-x-auto rounded-2xl border border-slate-800/70 bg-slate-950/80 p-5 text-xs text-slate-300">
<code>{`function launchProject() {
  return ['design', 'build', 'iterate']
    .map(step => step.toUpperCase());
}`}</code>
        </pre>
      </article>
    </section>

    <section class="section-shell space-y-10">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
        <article class="surface-card space-y-6 p-8">
          <h2 class="text-2xl font-semibold tracking-tight text-white md:text-3xl">Lists</h2>
          <div class="grid gap-8 md:grid-cols-2">
            <div>
              <h3 class="mb-3 text-sm font-semibold uppercase tracking-[0.35em] text-slate-400">Unordered</h3>
              <ul class="space-y-3 text-sm text-slate-300">
                {checklist.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div>
              <h3 class="mb-3 text-sm font-semibold uppercase tracking-[0.35em] text-slate-400">Ordered</h3>
              <ol class="space-y-3 text-sm text-slate-300">
                {ordered.map((item, index) => <li>{index + 1}. {item}</li>)}
              </ol>
            </div>
          </div>
        </article>
        <article class="surface-card space-y-6 p-8">
          <h2 class="text-2xl font-semibold tracking-tight text-white md:text-3xl">Buttons</h2>
          <div class="flex flex-wrap gap-3">
            <a href="#" class="btn btn-primary">Primary</a>
            <a href="#" class="btn btn-muted">Muted</a>
            <a href="#" class="btn btn-primary btn-sm">Small</a>
            <a href="#" class="btn btn-muted btn-sm">Ghost</a>
            <a href="#" class="btn btn-primary btn-block">Block</a>
          </div>
          <p class="text-xs text-slate-400">
            Buttons use Tailwind utilities behind the scenes via the <code class="rounded bg-slate-950/80 px-1 py-0.5 text-[0.65rem] text-sky-300">.btn</code> family of classes.
          </p>
        </article>
      </div>
    </section>

    <section class="section-shell space-y-10">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
        <article class="surface-card space-y-6 p-8 md:p-10">
          <h2 class="text-2xl font-semibold tracking-tight text-white md:text-3xl">Form</h2>
          <form class="grid gap-5 text-sm text-slate-200/90">
            <label class="flex flex-col gap-2">
              <span class="text-xs font-semibold uppercase tracking-[0.35em] text-slate-400">Name</span>
              <input type="text" placeholder="Ada Lovelace" class="rounded-2xl border border-slate-700/70 bg-slate-950/70 px-4 py-3 text-slate-100 placeholder:text-slate-500 focus:border-sky-400/70 focus:outline-none focus:ring-2 focus:ring-sky-400/40" />
            </label>
            <label class="flex flex-col gap-2">
              <span class="text-xs font-semibold uppercase tracking-[0.35em] text-slate-400">Email</span>
              <input type="email" placeholder="ada@example.com" class="rounded-2xl border border-slate-700/70 bg-slate-950/70 px-4 py-3 text-slate-100 placeholder:text-slate-500 focus:border-sky-400/70 focus:outline-none focus:ring-2 focus:ring-sky-400/40" />
            </label>
            <label class="flex flex-col gap-2">
              <span class="text-xs font-semibold uppercase tracking-[0.35em] text-slate-400">Message</span>
              <textarea rows="4" placeholder="Tell me about your project…" class="rounded-2xl border border-slate-700/70 bg-slate-950/70 px-4 py-3 text-slate-100 placeholder:text-slate-500 focus:border-sky-400/70 focus:outline-none focus:ring-2 focus:ring-sky-400/40"></textarea>
            </label>
            <div class="flex items-center gap-3">
              <input id="updates" type="checkbox" class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-sky-400 focus:ring-sky-400/50" />
              <label for="updates" class="text-xs text-slate-400">Send occasional updates</label>
            </div>
            <button type="submit" class="btn btn-primary w-fit">Send message</button>
          </form>
        </article>
        <article class="surface-card space-y-6 p-8 md:p-10">
          <h2 class="text-2xl font-semibold tracking-tight text-white md:text-3xl">Table</h2>
          <div class="overflow-hidden rounded-2xl border border-slate-800/70">
            <table class="min-w-full divide-y divide-slate-800/70 text-left text-sm text-slate-200">
              <thead class="bg-slate-950/80 text-xs uppercase tracking-[0.25em] text-slate-400">
                <tr>
                  <th class="px-5 py-3">Name</th>
                  <th class="px-5 py-3">Description</th>
                  <th class="px-5 py-3 text-right">Price</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-800/70 bg-slate-900/50">
                {tableRows.map(({ name, description, price }) => (
                  <tr>
                    <td class="px-5 py-4 font-semibold text-white">{name}</td>
                    <td class="px-5 py-4 text-slate-300">{description}</td>
                    <td class="px-5 py-4 text-right font-semibold text-sky-300">{price}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="text-xs text-slate-400">
            Tables inherit Tailwind utility styles and are wrapped in responsive containers to prevent overflow on smaller viewports.
          </p>
        </article>
      </div>
    </section>
  </main>
</GenericPageLayout>
