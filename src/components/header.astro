---
import NavToggle from '@components/NavToggle';
---
<header class="sticky top-0 z-50 mx-auto flex w-full items-center pr-6 pl-3 py-4 border-b border-white/10 bg-slate-950/80 backdrop-blur">
  <NavToggle client:load />
  <a
    href="/"
    class="group flex items-baseline gap-4 text-left transition no-underline hover:underline"
  >
    <h1 class="font-display text-lg font-semibold leading-tight tracking-tight text-slate-50">
      Jonathan Siler
    </h1>
    <h2 class="text-[0.65rem]/[1] font-medium uppercase tracking-[0.35em] text-slate-400">
      Web Technology Zen Master
    </h2>
  </a>
</header>
