---
import React from 'react';
import { VariableGlitch } from '@/decorators/VariableGlitch';
---
<section class="relative overflow-hidden bg-twilight-skeptic">
  <div class="mx-auto flex flex-col w-full max-w-6xl justify-center items-center gap-8 px-6 py-12 text-center md:text-left md:flex-row md:px-10 md:flex lg:px-12">
    <img
      src="/images/jonathan-alpha.png"
      alt="Soft gradient background"
      class="rounded-xl inset-shadow-xl inset-shadow-fuchsia-800/50 mix-blend-soft-light opacity-50 h-[400px] w-[300px] object-cover"
      loading="lazy"
    />
    <VariableGlitch client:load>
    <header class="space-y-4">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-sky-300">
        Welcome
      </p>
      <h1 class="text-4xl font-semibold tracking-tight text-white md:text-6xl">
        Hi, I'm Jonathan.
      </h1>
      <div class="max-w-2xl text-base text-slate-200 md:text-lg">
        <p>I work on websites and fix broken JavaScript and PHP. I love turning tangled stacks into simple, resilient experiences.</p>
      </div>
    </header>
    </VariableGlitch>
  </div>
</section>
