---
import { FaGithub, FaLinkedin } from 'react-icons/fa';
import { FaXTwitter } from 'react-icons/fa6';
const year = new Date().getFullYear();
---
<footer class="border-t border-white/10 bg-slate-950/80">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-10 px-6 py-12 md:flex-row md:items-center md:justify-between md:px-10 lg:px-12">
    <div class="space-y-4">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-slate-400">
        Stay connected
      </p>
      <ul class="flex items-center gap-4">
        <li>
          <a
            href="https://twitter.com/jonjonsiler"
            class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-slate-700/70 bg-slate-900/70 text-slate-200 transition hover:border-sky-400/70 hover:bg-sky-400/10 hover:text-sky-300"
            aria-label="Twitter"
          >
            <FaXTwitter className="h-5 w-5 fill-current" />
          </a>
        </li>
        <li>
          <a
            href="https://github.com/jonjonsiler"
            class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-slate-700/70 bg-slate-900/70 text-slate-200 transition hover:border-sky-400/70 hover:bg-sky-400/10 hover:text-sky-300"
            aria-label="GitHub"
          >
            <FaGithub className="h-5 w-5 fill-current" />
          </a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/jonathan-siler"
            class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-slate-700/70 bg-slate-900/70 text-slate-200 transition hover:border-sky-400/70 hover:bg-sky-400/10 hover:text-sky-300"
            aria-label="LinkedIn"
          >
            <FaLinkedin className="h-5 w-5 fill-current" />
          </a>
        </li>
      </ul>
    </div>
    <div class="space-y-2 text-xs text-slate-500">
      <p>© {year} Jonathan Siler. All rights reserved.</p>
      <p>Built with Astro and Tailwind CSS.</p>
    </div>
  </div>
</footer>
