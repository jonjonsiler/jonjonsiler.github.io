---
import HeadBase from '@partials/head-base.astro';
import Header from '@components/header.astro';
import Footer from '@components/footer.astro';
import classNames from 'classnames';

//import '/src/styles/theme/main.scss';
import '/src/styles/theme/global.css';

const { title, extendClass } = Astro.props;
const containerClass = classNames(
  [
    "flex-1"
  ],
  extendClass
);
---
<html lang="en">
	<head>
		<HeadBase title={title}/>
		<slot name="head" />
	</head>
	<body class="bg-slate-950 text-slate-100">
    <div class="relative flex min-h-screen flex-col">
      <Header />
      <main id="main" class={containerClass} >
        <slot />
      </main>
      <Footer />
    </div>
	</body>
</html>
