---
import HeadBase from '@partials/head-base.astro';
import Header from '@components/header.astro';
import NavigationMenu from '@components/navigation.astro';
import Footer from '@components/footer.astro';
import classNames from 'classnames';

import '/src/styles/theme/global.css';

const { title, extendClass } = Astro.props;
const containerClass = classNames(
  [
    "flex-1"
  ],
  extendClass
);
---
<html lang="en">
	<head>
		<HeadBase title={title}/>
		<slot name="head" />
	</head>
	<body class="bg-slate-950 text-slate-100" data-nav-state="open">
    <Header />
    <aside
      id="primary-navigation"
      class="fixed inset-y-0 left-0 z-40 flex h-screen max-w-xs flex-col overflow-y-auto border-r border-white/10 bg-slate-950/95 px-5 pb-3 pt-24 shadow-[0_10px_45px_rgba(2,6,23,0.85)] backdrop-blur"
      data-shell-sidebar
      aria-label="Primary"
    >
      <slot name="sidebar">
        <NavigationMenu
          orientation="vertical"
          size="sm"
          variant="sidebar"
          class="w-full gap-4 text-left"
        />
      </slot>
    </aside>
    <div class="flex min-h-screen flex-col bg-slate-950" data-shell-content>
      <main id="main" class={containerClass}>
        <slot />
      </main>
      <Footer />
    </div>
	</body>
</html>
